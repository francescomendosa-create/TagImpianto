rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Collezioni Tag Impianto — apri in sviluppo; poi restringi con Auth.
    match /tagImpianto_maps/{mapId} {
      allow read, write: if true;
    }
    match /tagImpianto_maps/{mapId}/tags/{tagId} {
      allow read, write: if true;
    }
  }
}
